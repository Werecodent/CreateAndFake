<Project>
  <!-- Project settings. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <NoWarn>$(NoWarn);NU1510;NU1903</NoWarn>
    <RootNamespace>Werecodent.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- Output settings. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(MSBuildThisFileDirectory)..\artifacts\bin\$(MSBuildProjectName)\$(Configuration)\$(TargetFramework)\$(MSBuildProjectName).xml</DocumentationFile>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\artifacts\obj\$(MSBuildProjectName)</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\artifacts\bin\$(MSBuildProjectName)</BaseOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- Package settings. -->
  <PropertyGroup>
    <Authors>Werecodent;CreateAndFake Contributors</Authors>
    <RepositoryUrl>https://github.com/Werecodent/CreateAndFake</RepositoryUrl>
    <PackageProjectUrl>https://werecodent.github.io/CreateAndFake/</PackageProjectUrl>
    <ReleaseNotes>https://github.com/Werecodent/CreateAndFake/releases/</ReleaseNotes>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <PackageIcon>PackageIcon.png</PackageIcon>
    <RepositoryType>Github</RepositoryType>
    <RepositoryType>git</RepositoryType>
    <PackageTags>
      automated-testing;clone;cloning;create;csharp;data;dotnet;equality;fake;fakes;mock;mocks;
      random;random-data;randomization;stubs;test-coverage;testing;tests;ttd;value-equality
    </PackageTags>
  </PropertyGroup>

  <!-- Extra files. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\site\docs\other\PackageReadme.md">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\site\images\PackageIcon.png">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <!-- Build dependencies. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Analyzers. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AsyncFixer" Version="2.1.0" PrivateAssets="All" />
    <PackageReference Include="Lindhart.Analyser.MissingAwaitWarning" Version="3.2.0" PrivateAssets="All" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.324" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" version="18.12.1" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="All" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="All" />
  </ItemGroup>
</Project>
