<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Werecodent.CreateAndFake</RootNamespace>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <DefineConstants>LEGACY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Werecodent.CreateAndFake.Toolbox</PackageId>
    <Description>Create &amp; Fake is a test support library, developed by humans, that makes robust testing easy by handling all manners of data generation, mocking, comparisons, validation and even automated requirement-based testing. This is the core package providing all tooling to use.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Design/Werecodent.CreateAndFake.Design.csproj" />
    <Using Include="Werecodent.CreateAndFake.Design.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="[2.0.0,)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="[2.0.0,)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="[2.0.0,)" />
  </ItemGroup>

</Project>
